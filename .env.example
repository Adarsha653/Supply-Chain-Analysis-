# Copy to .env and fill in (never commit .env)

# Flask
FLASK_PORT=5001
CATALOG_URL=http://127.0.0.1:5001/
FLASK_API_URL=http://127.0.0.1:5001/api/products
SAMPLE_FRAC=0.10
SAMPLE_SEED=42

# MongoDB Atlas — Option A: split vars (recommended if password has special chars)
MONGO_USER=supply_chain_user
MONGO_PASSWORD=your_password_here
MONGO_HOST=cluster0.8m00iht.mongodb.net
MONGO_APP_NAME=Cluster0

# MongoDB Atlas — Option B: full URI (or use this instead of Option A)
MONGO_URI=mongodb+srv://supply_chain_user:PASSWORD@cluster0.8m00iht.mongodb.net/?appName=Cluster0
MONGO_DB=supply_chain

# AWS S3 (Day 3+)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=supply-chain-dataco-yourname
AWS_REGION=us-east-1
AWS_PREFIX=incoming/

# Excel pipeline
EXCEL_PATH=step3/excel/NewOrders.xlsx

# SAP CRM sandbox (Day 7)
SAP_API_URL=
SAP_API_KEY=
ALERTS_CSV=exports/v_alerts.csv
